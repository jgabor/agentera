{
  "name": "agentera",
  "version": "3.0.0-dev.31",
  "description": "One CLI, many capabilities: project state, artifact validation, and capability routing for AI coding agents",
  "keywords": [
    "agentera",
    "agents",
    "cli",
    "orchestration"
  ],
  "homepage": "https://github.com/jgabor/agentera",
  "license": "Apache-2.0",
  "author": "Jonathan Gabor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgabor/agentera.git",
    "directory": "packages/cli"
  },
  "bin": {
    "agentera": "dist/bin/agentera.js"
  },
  "files": [
    "dist",
    "bundle"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "prepack": "node scripts/reject-direct-prepack.mjs",
    "test": "pnpm run test:source",
    "test:source": "node scripts/verify-lane.mjs source",
    "test:stress": "node scripts/verify-lane.mjs stress",
    "test:performance": "node scripts/verify-lane.mjs performance",
    "test:performance:integration": "node test/integration/performanceOwner.integration.mjs",
    "test:watch": "vp test watch --config vite.config.ts",
    "verify:package": "node scripts/verify-lane.mjs package",
    "verify:generated-overlap": "node scripts/verify-generated-overlap.mjs",
    "generated:cleanup": "node scripts/build-package.mjs --cleanup",
    "pack:dry-run": "node scripts/pack-package.mjs --dry-run",
    "verify:targeted": "node scripts/verify-lane.mjs policy targeted",
    "verify:precommit": "node scripts/verify-lane.mjs policy precommit",
    "verify:fast": "node scripts/verify-lane.mjs policy fast",
    "verify:local": "node scripts/verify-lane.mjs policy local",
    "verify:merge": "node scripts/verify-lane.mjs policy merge",
    "verify:scheduled": "node scripts/verify-lane.mjs policy scheduled",
    "verify:release": "node scripts/verify-lane.mjs policy release",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle:data": "node scripts/build-package.mjs",
    "publish:dev": "set -a; [ -f ../../.env ] && . ../../.env; set +a; node scripts/pack-package.mjs --publish --tag next"
  },
  "dependencies": {
    "smol-toml": "^1.3.1",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "vite-plus": "^0.1.22"
  },
  "engines": {
    "node": ">=22"
  },
  "agentera": {
    "suiteVersion": "3.0.0",
    "gitRef": "df63d4e6c71ed8129c30e8464ed3391ccf97d9d4"
  }
}
