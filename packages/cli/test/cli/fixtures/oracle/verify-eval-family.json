{
  "schemaVersion": "agentera.verifyEvalFamilyOracle.v1",
  "notes": "Frozen pass-envelope contract for `check verify eval <target> --format json`. Two targets share the same envelope shape: `eval semantic <fixture>` (offline-fixtures safety) and `eval skills` (dry-run or explicit-runtime). Pin is structural: required keys, value types, and the small set of literal values (command='verify', family='eval', status union, safety mode union). Field content that legitimately varies by target or fixture is not pinned. Request-validation failures are stderr diagnostics owned by verify.test.ts; parser-level invalid-input envelopes remain owned by invalid-input-envelope.json. The npm-cli-surface.json oracle covers the cross-cutting npm exit-code matrix.",
  "format": "json",
  "commandValue": "verify",
  "familyValue": "eval",
  "statusUnion": ["pass", "fail"],
  "formatValueUnion": ["text", "json"],
  "requiredTopLevelKeys": [
    "command",
    "status",
    "family",
    "target",
    "format",
    "engine",
    "diagnostics",
    "safety"
  ],
  "engine": {
    "requiredKeys": ["command", "exit_code"],
    "commandValueType": "array<string>",
    "exitCodeValueType": "number"
  },
  "diagnostics": {
    "requiredKeys": ["stdout", "stderr", "line_limit"],
    "stdoutValueType": "array<string>",
    "stderrValueType": "array<string>",
    "lineLimitValueType": "number",
    "lineLimitValue": 20
  },
  "safety": {
    "requiredKeys": ["mode", "summary", "live", "long_running_default"],
    "modeValueUnion": ["offline-fixtures", "offline-frozen-corpus", "dry-run", "explicit-runtime"],
    "summaryValueType": "string",
    "liveValueType": "boolean",
    "longRunningDefaultValueType": "boolean"
  },
  "targets": {
    "semantic": {
      "argv": [
        "check",
        "verify",
        "eval",
        "semantic",
        "fixtures/semantic/status-bare-message.md",
        "--format",
        "json"
      ],
      "exitCode": 0,
      "targetValueType": "string",
      "targetValue": "semantic",
      "safetyMode": "offline-fixtures",
      "live": false
    },
    "routing": {
      "argv": ["check", "verify", "eval", "routing", "--format", "json"],
      "exitCode": 0,
      "targetValueType": "string",
      "targetValue": "routing",
      "safetyMode": "offline-frozen-corpus",
      "live": false
    },
    "skills_dry_run": {
      "argv": ["check", "verify", "eval", "skills", "--dry-run", "--format", "json"],
      "exitCode": 0,
      "targetValueType": "string",
      "targetValue": "skills",
      "safetyMode": "dry-run",
      "live": false
    },
    "skills_run": {
      "description": "Out of scope for the default pinned shape — the live envelope is the same shape as the dry-run/explicit-runtime case but with `safety.live === true` and `engine.command` ending in `--runtime <runtime>` without `--dry-run`.",
      "safetyMode": "explicit-runtime",
      "live": true
    }
  },
  "relatedOracles": {
    "invalidInputEnvelope": "packages/cli/test/cli/fixtures/oracle/invalid-input-envelope.json",
    "npmCliSurface": "packages/cli/test/cli/fixtures/oracle/npm-cli-surface.json"
  }
}
