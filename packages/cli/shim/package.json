{
  "name": "agentera",
  "version": "0.0.2",
  "description": "npm shim for Agentera — delegates to the Python CLI until the 3.0 TypeScript release",
  "keywords": [
    "agentera",
    "agents",
    "cli",
    "orchestration"
  ],
  "homepage": "https://github.com/jgabor/agentera",
  "license": "Apache-2.0",
  "author": "Jonathan Gabor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jgabor/agentera.git",
    "directory": "packages/cli"
  },
  "bin": {
    "agentera": "./bin/agentera.mjs"
  },
  "files": [
    "bin",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "pnpm -C .. test test/shim/ && node --test test/*.test.mjs",
    "release:prepare": "node ../scripts/publication-transaction.mjs prepare stable",
    "publish:stable": "set -a; [ -f ../../../.env ] && . ../../../.env; set +a; node ../scripts/publication-transaction.mjs publish stable --authorize"
  },
  "engines": {
    "node": ">=22"
  },
  "agentera": {
    "suiteVersion": "2.7.7",
    "gitRef": "ce4a7054a8438b8b0aac013bac4b86ba1a9de3dd"
  }
}
